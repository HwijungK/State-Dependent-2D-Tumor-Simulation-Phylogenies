params {
    runs = "${projectDir}/assets/eden_runs.json"
    outdir = "${launchDir}/results"
    template = "${projectDir}/assets/SDEVO_template.xml"
    n = 100
    seed = 42
    chain_length = 5000000
    log_every = 1000
    beast = 'beast'
    beast_seed = 42
}

profiles {
    smoke {
        params.runs = "${projectDir}/tests/fixtures/eden_runs_smoke.json"
        params.n = 12
        params.chain_length = 100
        params.log_every = 20
    }
}
